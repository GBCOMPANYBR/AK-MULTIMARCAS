// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

enum VehicleCategory {
  POPULAR
  INTERMEDIARIO
  SUV
  PREMIUM
  LUXO
}

enum VehicleStatus {
  DISPONIVEL
  ALUGADO
  MANUTENCAO
  INATIVO
}

model Vehicle {
  id        String          @id @default(cuid())
  brand     String
  model     String
  year      Int
  color     String
  plate     String          @unique
  renavam   String
  chassis   String
  category  VehicleCategory
  currentKm Int             @default(0)

  dailyRate   Float
  weeklyRate  Float @default(0)
  monthlyRate Float @default(0)

  deposit           Float @default(0)
  kmFranchisePerDay Int   @default(200)
  kmExcessRate      Float @default(0)

  status     VehicleStatus @default(DISPONIVEL)
  showOnSite Boolean       @default(false)

  licensingExpiry DateTime?
  ipvaExpiry      DateTime?
  insuranceExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images              VehicleImage[]
  maintenanceRecords  MaintenanceRecord[]
  rentals             Rental[]
  financeEntries      FinanceEntry[]

  @@index([status])
  @@index([showOnSite])
  @@index([category])
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  km          Int
  description String
  cost        Float

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model Client {
  id          String   @id @default(cuid())
  fullName    String
  cpf         String   @unique
  rg          String
  cnhNumber   String
  cnhCategory String
  cnhExpiry   DateTime
  phone       String
  email       String?
  address     String
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals Rental[]

  @@index([cpf])
}

enum RentalStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum PaymentStatus {
  PAGO
  PARCIAL
  PENDENTE
}

enum PaymentMethod {
  PIX
  CARTAO
  DINHEIRO
}

model Rental {
  id String @id @default(cuid())

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  pickupDatetime         DateTime
  expectedReturnDatetime DateTime
  actualReturnDatetime   DateTime?

  kmOut Int
  kmIn  Int?

  fuelOut Int
  fuelIn  Int?

  dailyRate Float
  numDays   Int

  discount  Float @default(0)
  surcharge Float @default(0)

  deposit       Float         @default(0)
  depositMethod PaymentMethod @default(PIX)
  depositReturned Boolean     @default(false)

  paymentMethod PaymentMethod @default(PIX)
  paymentStatus PaymentStatus @default(PENDENTE)
  amountPaid    Float         @default(0)

  kmExcessCharge  Float @default(0)
  extraDaysCharge Float @default(0)
  fuelCharge      Float @default(0)
  damageCharge    Float @default(0)
  totalAmount     Float

  status RentalStatus @default(ATIVA)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklists     Checklist[]
  financeEntries FinanceEntry[]

  @@index([status])
  @@index([clientId])
  @@index([vehicleId])
}

enum ChecklistType {
  SAIDA
  DEVOLUCAO
}

model Checklist {
  id       String        @id @default(cuid())
  rentalId String
  rental   Rental        @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  type     ChecklistType

  conditionNotes String?
  damages        String?

  createdAt DateTime @default(now())

  photos RentalPhoto[]

  @@index([rentalId])
}

model RentalPhoto {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  url         String

  createdAt DateTime @default(now())

  @@index([checklistId])
}

enum FinanceEntryType {
  RECEITA
  DESPESA
}

model FinanceEntry {
  id          String           @id @default(cuid())
  type        FinanceEntryType
  category    String
  amount      Float
  date        DateTime
  description String?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  rentalId String?
  rental   Rental? @relation(fields: [rentalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([date])
  @@index([vehicleId])
}

model Testimonial {
  id          String  @id @default(cuid())
  clientName  String
  rating      Int     @default(5)
  text        String
  published   Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}
